# My Break Into Tech final SQL project, where I queried a dataset named "chinook", representing a digital media store.

#1.
SELECT CustomerId, firstname, lastname, country
FROM chinook.customers
WHERE country <> 'USA';

#2.
SELECT CustomerId, firstname, lastname, country
FROM chinook.customers
WHERE country = 'Brazil';

#3.
SELECT FirstName, LastName, InvoiceId, InvoiceDate, BillingCountry 
FROM chinook.invoices inv 
LEFT JOIN chinook.customers cust
ON cust.customerid = inv.customerid
WHERE BillingCountry = 'Brazil';

#4.
SELECT *
FROM chinook.employees
WHERE Title = 'Sales Support Agent';

#5.
SELECT DISTINCT BillingCountry
FROM chinook.invoices;

#6.
SELECT emp.lastname, emp.firstname, inv.invoiceid
FROM chinook.employees emp
INNER JOIN chinook.customers cust
ON cust.SupportRepId = emp.EmployeeId
INNER JOIN chinook.invoices inv
ON inv.customerId = cust.customerid;

#7.
SELECT cust.firstname || ' ' ||  cust.lastname AS CustName, cust.country, emp.lastname || ' ' || emp.firstname AS EmpName,  inv.total
FROM chinook.employees emp
INNER JOIN chinook.customers cust
ON cust.SupportRepId = emp.EmployeeId
INNER JOIN chinook.invoices inv
ON inv.customerId = cust.customerid;

#8.
SELECT COUNT(invoiceID) 
FROM chinook.invoices
WHERE InvoiceDate LIKE '2009%';

#9.
SELECT sum(total) TotalSales
FROM chinook.invoices
WHERE InvoiceDate LIKE '2009%';

#10.
SELECT tracks.name, inv.invoicelineid
FROM chinook.tracks 
INNER JOIN chinook.invoice_items inv
ON inv.trackid = tracks.trackid;

#11.
SELECT artists.name Artist, tracks.name Track, inv.invoicelineid
FROM chinook.tracks 
INNER JOIN chinook.invoice_items inv
ON inv.trackid = tracks.trackid
INNER JOIN chinook.albums
ON albums.albumid = tracks.albumid
INNER JOIN chinook.artists
ON artists.artistid = albums.artistid;

#12.
SELECT t.name Track, a.title Album, g.name Genre, m.name Media
FROM chinook.tracks t
INNER JOIN chinook.albums a
ON t.albumid = a.albumid
INNER JOIN chinook.media_types m
ON t.mediatypeid = m.mediatypeid
INNER JOIN chinook.genres g
ON g.genreid = t.genreid;

#13.
SELECT 
    emp.firstname || ' ' || emp.lastname AS EmpName, 
    ROUND (SUM(inv.total), 2) AS TotalSales
FROM chinook.employees emp
INNER JOIN customers cust ON emp.employeeid = cust.supportrepid
INNER JOIN invoices inv ON inv.customerid = cust.customerid
WHERE emp.title = 'Sales Support Agent'
GROUP BY emp.employeeid;

#14.
SELECT emp.firstname || ' ' || emp.lastname AS EmpName, ROUND (SUM(inv.total), 2) AS TotalSales
FROM employees emp
INNER JOIN customers cust ON emp.employeeid = cust.supportrepid
INNER JOIN invoices inv ON inv.customerid = cust.customerid
WHERE emp.title = 'Sales Support Agent'
AND inv.invoicedate LIKE "2009%"
GROUP BY EmpName
ORDER BY TotalSales DESC LIMIT 1;
